# ==========================================
# Sistema ADM Gerente - Configurações
# ==========================================

NODE_ENV=development

# Portas
PORT=4001
ADM_API_PORT=4001
ADM_WEB_PORT=4000

# URLs
NEXT_PUBLIC_API_URL=http://localhost:4001
CTRL_FARM_URL=http://localhost:3000
CTRL_FARM_API_URL=http://localhost:3001

# Banco de Dados
ADM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ctrlfarm_adm"

# Segurança & JWT
ADM_JWT_SECRET="adm-ctrlfarm-secret-key-super-secure-token-2026-xyz99"
ADM_JWT_REFRESH_SECRET="adm-ctrlfarm-refresh-secret-key-ultra-secure-999"

# Chaves RSA (Caminhos relativos ou absolutos)
RSA_PRIVATE_KEY_PATH="./keys/adm_private.pem"
RSA_PUBLIC_KEY_PATH="./keys/adm_public.pem"

# Google Firebase Cloud Storage (Distribuição de Releases e Updates na Nuvem)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""
